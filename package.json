{
  "name": "pg-dungeon",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "test": "tsx test/run-tests.ts",
    "smoke": "playwright test",
    "record:gameplay": "tsx scripts/record-gameplay.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "format": "prettier --write \"**/*.{cjs,css,html,js,jsx,json,jsonc,md,mjs,ts,tsx,yaml,yml}\" && node scripts/format-sql.mjs",
    "format:check": "prettier --check \"**/*.{cjs,css,html,js,jsx,json,jsonc,md,mjs,ts,tsx,yaml,yml}\" && node scripts/format-sql.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,jsx,json,jsonc,md,mjs,ts,tsx,yaml,yml}": "prettier --write",
    "*.sql": "node scripts/format-sql.mjs"
  },
  "keywords": [],
  "author": "Elmar Laigna",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gifenc": "^1.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
